APP_ENV=development

# Docker services (these hostnames are used INSIDE compose)
DATABASE_URL=postgresql+psycopg://aletheia:aletheia@postgres:5432/aletheia
REDIS_URL=redis://redis:6379/0
MLFLOW_URI=http://mlflow:5000

# Container paths - do not change unless you know why
STORAGE_DIR=/app/storage
MODEL_DIR=/app/models
DATASET_DIR=/app/datasets

# Persistent host cache for downloaded AI models.
# Default keeps the cache in the project but outside Git.
# For a shared Windows location, use for example:
# ALETHEIA_MODEL_CACHE=C:/AletheiaData/models
ALETHEIA_MODEL_CACHE=C:/AletheiaData/models

# Optional persistent evidence storage outside Git.
# Example Windows path: C:/AletheiaData/storage
ALETHEIA_STORAGE_DIR=C:/AletheiaData/storage

SECRET_KEY=change-me
